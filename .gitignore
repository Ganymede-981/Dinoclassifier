# HAM10000 Skin Lesion Classifier — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb   # keep training notebooks out of the repo root

# Model checkpoints & weights (large binaries — store on HF Hub instead)
checkpoints/
final_model/
*.pt
*.safetensors
*.bin

# Local model download cache (backend uses local_dir_use_symlinks=False)
.hub_cache/

# HuggingFace cache
.cache/

# Data
*.csv
*.parquet
*.arrow

# Evaluation artefacts
*.png
*.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
